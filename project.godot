; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Mimori"
run/main_scene="uid://g7257kmqf0vf"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=30
config/icon="res://appicon.png"
config/windows_native_icon="res://appicon.ico"

[autoload]

EngineGlobal="*uid://c4nc2bu65oc7v"
EventBus="*uid://bc7v0en1pgmgl"
LoggerGlobal="*uid://do8gsvy518nk0"
SettingsManager="*res://services/settings/settings_manager.gd"
ConfigService="*uid://bjfx2wjtlhfa8"
StatisticsManager="*res://services/statistics/statistics_manager.gd"
AudioManager="*uid://audmngr00000a"
BehaviorCatalog="*res://core/base/behavior_catalog.gd"
PersonalityCatalog="*res://core/base/personality_catalog.gd"
PetRoster="*res://core/base/pet_roster.gd"
MusicService="*res://services/music/music_service.gd"
AmbientService="*res://services/music/ambient_service.gd"
MenuBarService="*res://services/menu/menu_bar_service.gd"
DebugOverlayManager="*res://services/debug/debug_overlay_manager.gd"
ThemeManager="*res://services/theme/theme_manager.gd"
PluginManager="*res://core/plugins/plugin_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/resizable=false
window/size/borderless=true
window/size/always_on_top=true
window/size/transparent=true
window/subwindows/embed_subwindows=false
window/stretch/aspect="expand"
window/per_pixel_transparency/allowed=true

[editor]

export/convert_text_resources_to_binary=false

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.29951698, 0.29951698, 0.29951698, 0)
viewport/transparent_background=true
